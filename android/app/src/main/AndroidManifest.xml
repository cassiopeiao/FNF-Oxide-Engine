<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="FNF: Oxide Engine"
        android:theme="@style/Theme.FnfOxide">

        <!-- Read by com.google.androidgamesdk.GameActivity to load the Rust cdylib. -->
        <meta-data
            android:name="android.app.lib_name"
            android:value="fnf_oxide_engine" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
